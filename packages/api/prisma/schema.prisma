// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  CUSTOMER
  SERVER
  KITCHEN
  MANAGER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InventoryUnit {
  KG
  G
  L
  ML
  UNIT
  BOX
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PricingAdjustmentType {
  PERCENT_DISCOUNT
  FIXED_PRICE
}

// Core Models
model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  // Week 15 — tenant-specific configuration (15.3)
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  taxRate     Float    @default(0)
  operatingHours Json?  @default("{}")
  // Week 15 — billing / usage (15.6)
  plan              String @default("TRIAL")   // TRIAL | BASIC | PRO | ENTERPRISE
  subscriptionStatus String @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED
  seatsLimit        Int    @default(10)
  theme       Json?    @default("{}")
  features    Json?    @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  menus       Menu[]
  orders      Order[]
  tables      Table[]
  inventory   InventoryItem[]
  suppliers   Supplier[]
  purchaseOrders PurchaseOrder[]
  
  @@index([slug])
}

model User {
  id          String   @id @default(uuid())
  email       String
  password    String
  firstName   String
  lastName    String
  phone       String?
  role        UserRole @default(CUSTOMER)
  avatar      String?
  isActive    Boolean  @default(true)
  emailVerified Boolean @default(false)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  orders      Order[]
  reviews     Review[]
  
  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([email])
}

model Menu {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  categories  Category[]
  
  @@index([tenantId])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  menuId      String
  // Subcategory support: null = top-level category; otherwise parent category within the same menu.
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  menu        Menu      @relation(fields: [menuId], references: [id])
  items       MenuItem[]
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  
  @@index([menuId])
  @@index([parentId])
}

model MenuItem {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Float
  image           String?
  preparationTime Int?     // in minutes
  calories        Int?
  protein         Float?
  carbs           Float?
  fat             Float?
  isAvailable     Boolean  @default(true)
  isVegetarian    Boolean  @default(false)
  isVegan         Boolean  @default(false)
  isGlutenFree    Boolean  @default(false)
  categoryId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  category        Category   @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  pricingRules         MenuPricingRule[]
  availabilityWindows  MenuItemAvailabilityWindow[]
  
  @@index([categoryId])
  @@index([isAvailable])
}

// Time-scoped price overrides for a menu item (e.g. happy hour).
// Exactly one matching rule applies — see packages/shared/src/menu.ts.
model MenuPricingRule {
  id             String                @id @default(uuid())
  menuItemId     String
  adjustmentType PricingAdjustmentType
  amount         Float                 // percent (0..100] or absolute target price (>0)
  name           String?
  daysOfWeek     Int[]                 @default([]) // 0=Sunday..6=Saturday; empty = every day
  startTime      String?               // inclusive "HH:mm" local time
  endTime        String?               // exclusive "HH:mm"; < startTime wraps past midnight
  priority       Int                   @default(0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  @@index([menuItemId])
}

// Time windows during which a menu item may be ordered.
// No active windows → item.isAvailable global toggle decides alone.
model MenuItemAvailabilityWindow {
  id         String   @id @default(uuid())
  menuItemId String
  name       String?
  daysOfWeek Int[]    @default([]) // empty = every day
  startTime  String?
  endTime    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  @@index([menuItemId])
}

model Table {
  id          String   @id @default(uuid())
  name        String
  number      String
  capacity    Int?
  location    String?
  qrCode      String?  @unique
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  orders      Order[]
  
  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([qrCode])
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Float
  taxAmount       Float      @default(0)
  discountAmount  Float      @default(0)
  tableNumber     String?
  specialRequests String?
  customerId      String
  tenantId        String
  tableId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
  
  customer        User     @relation(fields: [customerId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  table           Table?   @relation(fields: [tableId], references: [id])
  items           OrderItem[]
  payment         Payment?
  reviews         Review[]
  
  @@unique([tenantId, orderNumber])
  @@index([customerId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  menuItemId         String
  quantity           Int
  unitPrice          Float
  specialInstructions String?
  status             OrderStatus @default(PENDING)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  order              Order    @relation(fields: [orderId], references: [id])
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])
  
  @@index([orderId])
  @@index([menuItemId])
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String   @unique
  amount          Float
  method          String   // stripe, paypal, cash, etc.
  transactionId   String?
  status          PaymentStatus @default(PENDING)
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?
  
  order           Order    @relation(fields: [orderId], references: [id])
  
  @@index([orderId])
  @@index([transactionId])
}

model Review {
  id          String   @id @default(uuid())
  rating      Int      // 1-5
  comment     String?
  orderId     String   @unique
  customerId  String
  tenantId    String
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  order       Order    @relation(fields: [orderId], references: [id])
  customer    User     @relation(fields: [customerId], references: [id])
  
  @@index([customerId])
  @@index([tenantId])
  @@index([isVisible])
}

model InventoryItem {
  id              String   @id @default(uuid())
  name            String
  sku             String
  currentStock    Float
  minStock        Float
  maxStock        Float?
  unit            InventoryUnit @default(UNIT)
  costPrice       Float?
  sellingPrice    Float?
  supplierId      String?
  tenantId        String
  isActive        Boolean  @default(true)
  lastRestockedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  transactions    InventoryTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([supplierId])
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  itemId          String
  transactionType String   // RESTOCK, USAGE, ADJUSTMENT, RETURN
  quantity        Float
  unitCost        Float?
  reference       String?  // order number, invoice, etc.
  notes           String?
  performedBy     String?  // user id or name
  tenantId        String
  createdAt       DateTime @default(now())
  
  item            InventoryItem @relation(fields: [itemId], references: [id])
  
  @@index([itemId])
  @@index([tenantId])
  @@index([createdAt])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  inventory   InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  orderNumber String
  status      PurchaseOrderStatus @default(DRAFT)
  supplierId  String
  tenantId    String
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantityOrdered  Float
  quantityReceived Float  @default(0)
  unitCost         Float?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([purchaseOrderId, inventoryItemId])
  @@index([purchaseOrderId])
  @@index([inventoryItemId])
}

// Multi-tenancy and feature flags
model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isEnabled])
}

model ApiKey {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  tenantId    String?
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([expiresAt])
}
