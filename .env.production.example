# Production environment template — deploy/docker-compose.prod.yml
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production        # secrets for the operator account only
#   # fill in every REQUIRED value, then follow docs/deployment/README.md §9
#
# Never commit .env.production (already covered by .gitignore). Dump the values
# into a secret manager before the first deploy — the file is the only copy.
#
# Generate secrets:
#   openssl rand -hex 32     # JWT_SECRET
#   openssl rand -hex 32     # ENCRYPTION_KEY (>= 16 chars, unique per env)
#   openssl rand -base64 24  # POSTGRES_PASSWORD (URL-safe, avoid @ : / # ?)

# ── Public origins (used for CORS, email links, certs and the web build) ─────
# The apex domain that tenants live under, e.g. restaurant.example.com.
# Requires wildcard DNS: `A *.restaurant.example.com -> <server ip>`.
TENANT_ROOT_DOMAIN=restaurant.example.com
# Browser-facing web origin(s), comma-separated (CORS allow-list).
ALLOWED_ORIGINS=https://restaurant.example.com,https://www.restaurant.example.com
# Public web origin (email links) and public API origin (baked into the web
# bundle at BUILD time — changing it requires a rebuild, not a restart).
PUBLIC_WEB_URL=https://restaurant.example.com
PUBLIC_API_URL=https://api.restaurant.example.com
# Where the /pricing "contact us" CTA points.
SALES_EMAIL=sales@restaurant.example.com
# Let's Encrypt account contact. Watches expiry notices + abuse reports.
ACME_EMAIL=ops@restaurant.example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres is NOT published to the host; these are consumed over the compose
# network only (and interpolated into DATABASE_URL for api/migrate/seed).
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=CHANGE_ME_url_safe_random_password
POSTGRES_DB=restaurant_management

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# All API replicas must share JWT_SECRET, or tokens stop validating.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# At-rest key material; GET /api/security/health fails in prod when unset/<16.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Platform operator (used once by the `seed` one-shot service) ─────────────
PLATFORM_ADMIN_EMAIL=platform@restaurant.example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Rate limits (requests per 60s window; defaults shown) ────────────────────
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_TENANT_MAX=3000
# LOG_LEVEL=info

# ── Notification email ──────────────────────────────────────────────────────
# Required for verification / password-reset / invite mail. Confirm the host
# permits outbound 587/465 (many providers block it) or use a transactional
# provider's 443 API instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASS=CHANGE_ME_smtp_password

# ─ Optional integrations ───────────────────────────────────────────────────
# QAPPR_API_URL=https://api.qappr.com
# QAPPR_API_KEY=CHANGE_ME_qappr_key