# Database
DATABASE_URL=postgresql://restaurant:restaurant123@localhost:5432/restaurant_management

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Security (Week 22)
# Encryption key for at-rest protection (tokens are hashed; PII encryption uses this).
# MUST be >= 16 chars and unique per environment. GET /api/security/health flags when unset.
ENCRYPTION_KEY=change-me-this-is-not-a-production-secret
# Behind a TLS-terminating proxy/CDN, set TRUE so req.ip reflects the real client.
TRUST_PROXY=false
# Per-IP rate limits (requests per 60s window).
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_MAX=300
# S1.4 — per-tenant fairness ceiling (requests per 60s, keyed on the verified
# JWT tenant; IP fallback for anonymous traffic). Runaway-guard, not a throttle.
RATE_LIMIT_TENANT_MAX=3000

# API
PORT=3001
NODE_ENV=development

# Multi-tenancy (S1.3)
# Root domain for deterministic tenant subdomain resolution in production
# ({tenant}.yourapp.com → slug "tenant"). When set, ONLY hosts under this
# root resolve a tenant — the apex/www marketing host never does. Leave unset
# in dev (localhost can never resolve a subdomain anyway).
# TENANT_ROOT_DOMAIN=yourapp.com

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password

# QappR Integration
QAPPR_API_URL=https://api.qappr.com
QAPPR_API_KEY=your-qappr-api-key
